# Copy to .env and fill in real values. Never commit the real .env —
# it's already in .gitignore. Production secrets belong in the
# deployment's secrets manager, not in a file on disk long-term.

ENVIRONMENT=local

# ---- Database ----
POSTGRES_DB=archana_hmis
POSTGRES_USER=archana
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+asyncpg://archana:CHANGE_ME_STRONG_RANDOM_PASSWORD@postgres:5432/archana_hmis
DATABASE_URL_SYNC=postgresql+psycopg2://archana:CHANGE_ME_STRONG_RANDOM_PASSWORD@postgres:5432/archana_hmis

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- MinIO ----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=archana_minio
MINIO_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET
MINIO_SECURE=false

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Passkeys (WebAuthn / Face ID / Touch ID) ----
# RP_ID must be the bare domain the frontend is served from (no scheme/port)
# and ORIGIN(s) the full origin(s) — both must exactly match what the
# browser sees, or the ceremony is refused (that mismatch check is what
# makes a passkey unphishable). Defaults below match the pinned local dev
# frontend port (3100). Update both for staging/production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Dr. Archana IVF & Women Centre
WEBAUTHN_ORIGIN=["http://localhost:3100"]

# ---- Frontend ----
# Read by dr-archana-ivf-prototype/lib/api/client.ts. The API is published
# on host port 8600 (see docker-compose.dev.yml — 8000 was already taken on
# the original dev machine), not 8080.
NEXT_PUBLIC_API_URL=http://localhost:8600/api/v1

# ---- Asset QR ----
# Base URL encoded into a printed asset QR label as `<base>/#scan=<token>`.
# Normally the frontend forwards its own NEXT_PUBLIC_APP_URL as the `?base=`
# query param and this is unused. Set it only if labels are generated by a
# tool that does not pass `?base=`. Leave empty => the QR holds the bare
# opaque token (still resolvable via "Scan / enter QR token"). No hospital
# IP/hostname is baked into the code — it comes from config only.
# e.g. ASSET_QR_BASE_URL=https://hmis.hospital.local
ASSET_QR_BASE_URL=

# ---- CORS ----
# Origins allowed to call the API with credentials (cookies). The frontend
# dev server is run pinned to port 3100 (`npm run dev -- -p 3100`) —
# see DEVELOPER_HANDOFF.md §6 — specifically so this list doesn't have to
# change on every restart. If you run the frontend on a different port,
# add that origin here and restart the `api` container, or every request
# will fail as a CORS preflight error.
CORS_ORIGINS=["http://localhost:3100","http://localhost:3000","https://hmis.archanaivf.in"]
