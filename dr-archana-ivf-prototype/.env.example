# Frontend environment — copy to .env.local and adjust if needed.
#
#   cp .env.example .env.local
#
# This file is only needed if your backend is not on the default
# localhost:8600. The code in lib/api/client.ts already falls back to
# http://localhost:8600/api/v1 when this is unset, so a standard local
# setup works without creating .env.local at all.
#
# Note the variable name: NEXT_PUBLIC_API_URL (not ..._API_BASE_URL).
# It must include the /api/v1 suffix.
NEXT_PUBLIC_API_URL=http://localhost:8600/api/v1

# App base URL that a printed asset QR points at: the QR encodes
#   <NEXT_PUBLIC_APP_URL>/#scan=<opaque-token>
# so a management phone can scan the sticker and open this app straight at the
# scanned asset. Local dev can leave this unset (the code falls back to the
# current browser origin). For the hospital deployment set it to the internal
# server address IT provides and rebuild the frontend, e.g.
#   NEXT_PUBLIC_APP_URL=http://192.0.2.50:3000
#   NEXT_PUBLIC_APP_URL=https://hmis.hospital.local
# Never a public URL; on-premise LAN only. No IP is hardcoded in the source.
NEXT_PUBLIC_APP_URL=http://localhost:3000
